# Lightspeed API credentials
LIGHTSPEED_API_KEY=your_api_key_here
LIGHTSPEED_API_SECRET=your_api_secret_here

# Server port (Railway sets this automatically)
PORT=3000

# Login voor de app zelf (HTTP Basic Auth) — verplicht, de server weigert
# anders alle verzoeken. Kies hier zelf een gebruikersnaam/wachtwoord voor
# en zet deze in Railway (Variables-tab), niet in dit bestand.
APP_USERNAME=kies_een_gebruikersnaam
APP_PASSWORD=kies_een_sterk_wachtwoord

# Optioneel: map waar de status-bestanden (print/order/verzend-status)
# worden opgeslagen. Laat leeg om naast de code op te slaan (huidige
# gedrag). Zet dit op het mount path van een Railway Volume (bv. /data)
# om de data een redeploy te laten overleven.
DATA_DIR=
